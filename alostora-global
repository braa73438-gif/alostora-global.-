<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AL-OSTORA GUIDE | دليل الأسطورة العالمي</title>
    <!-- استدعاء خط Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Cairo', sans-serif; }
        body { background: #080808; color: #fff; line-height: 1.6; }
        
        /* Header */
        header { background: #000; border-bottom: 2px solid #D4AF37; display: flex; justify-content: space-between; padding: 15px 5%; align-items: center; flex-wrap: wrap; gap: 10px; }
        .logo { color: #D4AF37; font-weight: 900; font-size: 20px; display: flex; align-items: center; gap: 8px; }
        .site-title { font-size: 14px; color: #ccc; }

        /* Countries Navigation */
        .countries { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; padding: 15px 5%; background: #111; border-bottom: 1px solid #222; }
        .countries span { background: #1f1f1f; border: 1px solid #333; padding: 6px 18px; border-radius: 20px; cursor: pointer; font-size: 13px; font-weight: 600; transition: 0.3s; color: #ddd; }
        .countries span:hover, .countries span.active { background: #D4AF37; color: #000; border-color: #D4AF37; font-weight: 900; }

        /* Hero Section */
        .hero { text-align: center; padding: 50px 5% 30px; background: radial-gradient(circle at center, #1a180e 0%, #080808 70%); }
        .hero h1 { font-size: 36px; color: #D4AF37; margin-bottom: 10px; font-weight: 900; }
        .hero p { color: #aaa; font-size: 15px; margin-bottom: 25px; }

        /* Search Bar */
        .search-box { max-width: 500px; margin: 0 auto; display: flex; gap: 10px; }
        .search-box input { width: 100%; padding: 12px 20px; border-radius: 25px; border: 1px solid #333; background: #111; color: #fff; font-size: 14px; outline: none; }
        .search-box input:focus { border-color: #D4AF37; }

        /* Grid & Offer Cards */
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; padding: 30px 5%; max-width: 1300px; margin: 0 auto; }
        .card { background: #121212; border-radius: 14px; overflow: hidden; border: 1px solid #222; transition: transform 0.3s, border-color 0.3s; display: flex; flex-direction: column; }
        .card:hover { transform: translateY(-5px); border-color: #D4AF37; }
        .card img { width: 100%; height: 180px; object-fit: cover; }
        .card-body { padding: 15px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
        
        .badge-container { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .badge { background: #D4AF37; color: #000; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 900; }
        .location { font-size: 12px; color: #888; }
        
        .card h3 { font-size: 16px; margin-bottom: 15px; color: #fff; }
        
        .price-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .price { color: #D4AF37; font-weight: 700; font-size: 16px; }
        .old-price { text-decoration: line-through; color: #666; font-size: 12px; margin-left: 5px; }

        .btn-whatsapp { display: flex; align-items: center; justify-content: center; gap: 8px; background: #25D366; color: #fff; text-decoration: none; padding: 10px; border-radius: 8px; font-weight: 700; font-size: 13px; transition: 0.3s; }
        .btn-whatsapp:hover { background: #1eb954; }

        /* Footer */
        footer { text-align: center; padding: 20px; background: #000; border-top: 1px solid #222; font-size: 13px; color: #777; margin-top: 40px; }
    </style>
</head>
<body>

<header>
    <div class="logo">🌍 AL-OSTORA GLOBAL</div>
    <div class="site-title">دليل الأسطورة العالمي - العروض والخدمات</div>
</header>

<!-- قائمة الدول -->
<div class="countries">
    <span class="active" onclick="filterCountry('all', this)">🌍 الكل</span>
    <span onclick="filterCountry('ye', this)">🇾🇪 اليمن</span>
    <span onclick="filterCountry('sa', this)">🇸🇦 السعودية</span>
    <span onclick="filterCountry('ae', this)">🇦🇪 الإمارات</span>
    <span onclick="filterCountry('eg', this)">🇪🇬 مصر</span>
    <span onclick="filterCountry('tr', this)">🇹🇷 تركيا</span>
    <span onclick="filterCountry('global', this)">🌐 عالمي</span>
</div>

<!-- الواجهة الرئيسية -->
<section class="hero">
    <h1>كل عروض العالم في مكان واحد</h1>
    <p>استكشف أفضل الخصومات والخدمات الحصرية عبر مختلف المدن والدول</p>
    <div class="search-box">
        <input type="text" id="searchInput" onkeyup="searchOffers()" placeholder="ابحث عن عرض، مدينة، أو متجر...">
    </div>
</section>

<!-- العروض -->
<div class="grid" id="offersGrid">
    
    <!-- عرض اليمن -->
    <div class="card" data-country="ye">
        <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=600" alt="مطعم">
        <div class="card-body">
            <div>
                <div class="badge-container">
                    <span class="badge">خصم 30%</span>
                    <span class="location">🇾🇪 تعز - شارع جمال</span>
                </div>
                <h3>خصم 30% على وجبة مشاوي مشكلة لشخصين</h3>
            </div>
            <div>
                <div class="price-section">
                    <div class="price">12,000 ر.ي <span class="old-price">17,000 ر.ي</span></div>
                </div>
                <a href="https://wa.me/967000000000?text=أريد%20الاستفسار%20عن%20عرض%20المشاوي" target="_blank" class="btn-whatsapp">تواصل عبر واتساب</a>
            </div>
        </div>
    </div>

    <!-- عرض السعودية -->
    <div class="card" data-country="sa">
        <img src="https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?w=600" alt="فندق">
        <div class="card-body">
            <div>
                <div class="badge-container">
                    <span class="badge">خصم 50%</span>
                    <span class="location">🇸🇦 جدة - الكورنيش</span>
                </div>
                <h3>فنادق جدة - احجز ليلتين بسعر ليلة واحدة</h3>
            </div>
            <div>
                <div class="price-section">
                    <div class="price">450 ر.س <span class="old-price">900 ر.س</span></div>
                </div>
                <a href="https://wa.me/966000000000?text=أريد%20الاستفسار%20عن%20عرض%20الفنادق" target="_blank" class="btn-whatsapp">تواصل عبر واتساب</a>
            </div>
        </div>
    </div>

    <!-- عرض الإمارات -->
    <div class="card" data-country="ae">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600" alt="منتج">
        <div class="card-body">
            <div>
                <div class="badge-container">
                    <span class="badge">خصم 40%</span>
                    <span class="location">🇦🇪 دبي - دبي مول</span>
                </div>
                <h3>تخفيضات الأحذية الرياضية الأصلية - تشكيلة جديدة</h3>
            </div>
            <div>
                <div class="price-section">
                    <div class="price">299 د.إ <span class="old-price">499 د.إ</span></div>
                </div>
                <a href="https://wa.me/971000000000?text=أريد%20الاستفسار%20عن%20عرض%20الأحذية" target="_blank" class="btn-whatsapp">تواصل عبر واتساب</a>
            </div>
        </div>
    </div>

    <!-- عرض عالمي -->
    <div class="card" data-country="global">
        <img src="https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?w=600" alt="دورة">
        <div class="card-body">
            <div>
                <div class="badge-container">
                    <span class="badge">خصم 70%</span>
                    <span class="location">🌐 أونلاين - جميع الدول</span>
                </div>
                <h3>دورة التسويق الرقمي وإدارة الوكالات - شهادة معتمدة</h3>
            </div>
            <div>
                <div class="price-section">
                    <div class="price">$49 <span class="old-price">$160</span></div>
                </div>
                <a href="https://wa.me/967000000000?text=أريد%20التسجيل%20في%20الدورة" target="_blank" class="btn-whatsapp">تواصل عبر واتساب</a>
            </div>
        </div>
    </div>

</div>

<footer>
    دليل الأسطورة العالمي © 2026 AL-OSTORA GUIDE - جميع الحقوق محفوظة
</footer>

<script>
    // تصفية حسب الدولة
    function filterCountry(country, element) {
        document.querySelectorAll('.countries span').forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');

        let cards = document.querySelectorAll('.card');
        cards.forEach(card => {
            if (country === 'all' || card.getAttribute('data-country') === country) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // البحث في العروض
    function searchOffers() {
        let input = document.getElementById('searchInput').value.toLowerCase();
        let cards = document.querySelectorAll('.card');

        cards.forEach(card => {
            let text = card.innerText.toLowerCase();
            if (text.includes(input)) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>

</body>
</html>
